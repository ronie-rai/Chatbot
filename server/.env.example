# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://chatbot:chatbot_secret@localhost:5432/chatbot_db?schema=public"

# ─── AI ────────────────────────────────────────────────────────────────────────
# Anthropic Claude API key — get from https://console.anthropic.com/
CLAUDE_API_KEY="sk-ant-..."

# Claude model to use (e.g. claude-3-5-sonnet-20241022)
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

# ─── Google Sheets Integration ─────────────────────────────────────────────────
# Path to your Google Cloud service account JSON credentials file
# (Do NOT commit this file — add *.json to .gitignore)
GOOGLE_SERVICE_ACCOUNT_PATH="./google-credentials.json"

# ─── Real-time (Socket.io) ─────────────────────────────────────────────────────
# The URL the Next.js server uses to communicate with the realtime server
REALTIME_SERVER_URL="http://localhost:4000"

# Shared secret between the API server and the realtime server
REALTIME_SECRET="change-me-in-production"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
