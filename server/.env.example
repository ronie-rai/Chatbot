# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. Supabase, Neon, Railway, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/chatbot_db?schema=public"

# ─── AI ────────────────────────────────────────────────────────────────────────
# Groq API key — get from https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Groq model to use (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL="openai/gpt-oss-120b"

# ─── Google Sheets Integration ─────────────────────────────────────────────────
# Full Google Sheet URL (e.g. https://docs.google.com/spreadsheets/d/YOUR_ID/edit) or ID
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit"

# Path to your Google Cloud service account JSON credentials file
# (Do NOT commit this file — add *.json to .gitignore)
GOOGLE_SERVICE_ACCOUNT_PATH="./google-credentials.json"

# ─── Real-time (Socket.io) ─────────────────────────────────────────────────────
# The URL the Next.js server uses to communicate with the realtime server
REALTIME_SERVER_URL="http://localhost:4000"

# Shared secret between the API server and the realtime server
REALTIME_SECRET="change-me-in-production"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
