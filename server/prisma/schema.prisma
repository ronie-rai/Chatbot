// Prisma schema — WhatsApp-style AI Chatbot SaaS
// Phase 1: Full data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  BOT
  ADMIN
}

enum ConversationKind {
  DIRECT
  GROUP
  AI
}

enum MessageKind {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  TOOL_RESULT
  SYSTEM
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum SheetAuthMode {
  SERVICE_ACCOUNT
  OAUTH2
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

/// A SaaS tenant (company / team using the chatbot platform).
model Tenant {
  id        String   @id @default(cuid())
  name      String
  /// URL-friendly identifier, e.g. "acme-corp"
  slug      String   @unique
  createdAt DateTime @default(now())

  // Relations
  users           User[]
  conversations   Conversation[]
  sheetConnections SheetConnection[]

  @@map("tenants")
}

// ─── User ─────────────────────────────────────────────────────────────────────

/// A user within a tenant — can be a human, a bot, or an admin.
model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String
  /// Bcrypt hash — null for BOT users (they don't log in)
  passwordHash String?
  avatarUrl    String?
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants Participant[]
  messages     Message[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Conversation ─────────────────────────────────────────────────────────────

/// A chat thread — can be a DM, a group chat, or an AI conversation.
model Conversation {
  id        String           @id @default(cuid())
  tenantId  String
  /// Optional display name (required for GROUP; optional for DIRECT/AI)
  name      String?
  kind      ConversationKind @default(AI)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants Participant[]
  messages     Message[]

  @@index([tenantId])
  @@map("conversations")
}

// ─── Participant ──────────────────────────────────────────────────────────────

/// Join table: a user's membership in a conversation.
model Participant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("participants")
}

// ─── Message ──────────────────────────────────────────────────────────────────

/// A single chat message — from a human, bot, or system.
model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  body           String        @db.Text
  kind           MessageKind   @default(TEXT)
  status         MessageStatus @default(SENT)
  mediaUrl       String?
  fileName       String?
  fileSize       Int?
  mimeType       String?
  duration       Int?
  /// For TOOL_RESULT messages: extracted data, tool call ids, etc.
  metadata       Json?
  createdAt      DateTime      @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ─── SheetConnection ──────────────────────────────────────────────────────────

/// Per-tenant Google Sheets configuration for the AI extraction tool.
model SheetConnection {
  id            String        @id @default(cuid())
  tenantId      String
  spreadsheetId String
  /// The specific sheet/tab name within the spreadsheet
  sheetName     String        @default("Sheet1")
  authMode      SheetAuthMode @default(SERVICE_ACCOUNT)
  /// JSON array of SheetColumn objects defining what the AI extracts.
  /// Shape: [{ name, label, description, required }]
  columns       Json
  createdAt     DateTime      @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sheet_connections")
}

// ─── SystemSetting ───────────────────────────────────────────────────────────

/// Global system configuration shared across all tenants (e.g. shared AI API key).
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
