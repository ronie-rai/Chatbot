# ─── API ───────────────────────────────────────────────────────────────────────
# Base URL of the Next.js server (must start with EXPO_PUBLIC_ to be exposed)
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ─── Real-time ─────────────────────────────────────────────────────────────────
# Base URL of the Socket.io realtime server
EXPO_PUBLIC_REALTIME_URL="http://localhost:4000"

# ─── App ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME="Chatbot"
EXPO_PUBLIC_APP_ENV="development"
