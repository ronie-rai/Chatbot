# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# ─── Security ──────────────────────────────────────────────────────────────────
# Shared secret used to validate requests from the Next.js API server
REALTIME_SECRET="change-me-in-production"

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
